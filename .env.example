# ============================================================
# CIPHER — Environment Variable Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control — it is in .gitignore.
#
#   cp .env.example .env
#
# These values override their equivalents in config/config.yaml
# at runtime (see src/utils/config_loader.py for the override logic).
# ============================================================

# --- Kafka -------------------------------------------------------------------
# Bootstrap server address. Use 'kafka:9092' when running inside Docker,
# or 'localhost:9092' when running the app directly on the host.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- MLflow ------------------------------------------------------------------
# Tracking server URI. Use the Docker service name inside Docker Compose.
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Application -------------------------------------------------------------
# Runtime environment tag (production | staging | development)
CIPHER_ENV=production

# Logging verbosity (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO
