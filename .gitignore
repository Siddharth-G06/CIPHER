# Data — never commit raw CSVs (too large, potentially sensitive)
data/
*.csv

# Trained models — large binary files
models/
*.pkl

# MLflow artifacts — regeneratable
mlruns/

# Plots — regeneratable
plots/

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# Environment
.env
venv/
*.egg-info/

# Logs
logs/
*.log

# Jupyter checkpoints
.ipynb_checkpoints/

# Generated PDF reports
reports/

# Kafka data volume (if running outside Docker)
kafka-data/
kafka_data/

# confluent kafka logs
*.kafka.log